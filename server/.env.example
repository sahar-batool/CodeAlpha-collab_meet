PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/collab-meet?retryWrites=true&w=majority
JWT_SECRET=generate-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Where uploaded files are stored (on Railway, point this at a mounted volume)
UPLOAD_DIR=uploads